# ---------------------------------------------------------------------------
# Neo4j MCP Gateway — configuration
# Copy to .env and fill in your values:   cp .env.example .env
# The .env file is git-ignored; never commit real credentials.
# ---------------------------------------------------------------------------

# --- Neo4j connection -------------------------------------------------------
# These SAME credentials flow to BOTH the official downstream MCP server AND
# the YAML use-case tool executor (the neo4j Python driver).
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# --- Official downstream Neo4j MCP server -----------------------------------
# How to launch https://github.com/neo4j/mcp. Full command line (shell-split).
# Default runs the published PyPI wheel via uvx (no manual install needed).
NEO4J_MCP_CMD=uvx neo4j-mcp-server
#
# Alternatives (uncomment ONE):
#   Docker image (bolt on the host -> host.docker.internal):
# NEO4J_MCP_CMD=docker run -i --rm -e NEO4J_URI -e NEO4J_USERNAME -e NEO4J_PASSWORD -e NEO4J_DATABASE neo4j/mcp
#   A locally built Go binary:
# NEO4J_MCP_CMD=/usr/local/bin/neo4j-mcp
#   A pinned wheel version:
# NEO4J_MCP_CMD=uvx neo4j-mcp-server@1.5.3

# --- Optional downstream passthroughs (forwarded only if set) ---------------
# NEO4J_READ_ONLY=false          # true disables the downstream write-cypher tool
NEO4J_TELEMETRY=false            # downstream telemetry (defaults to false here)
# NEO4J_LOG_LEVEL=info
# NEO4J_LOG_FORMAT=text
# NEO4J_SCHEMA_SAMPLE_SIZE=100

# --- Gateway options --------------------------------------------------------
# TOOLS_DIR=tools                # where to discover *.yaml use-case tools
# USECASE_PREFIX=usecase_        # namespace prefix for YAML tool names
# GATEWAY_NAME=neo4j-mcp-gateway
