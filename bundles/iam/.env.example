# Optional per-bundle connection override for the IAM bundle.
# Copy to `.env` (git-ignored) to point IAM at its OWN Neo4j instance —
# e.g. a separate Aura instance — without touching the repo-root .env.
# Anything set here overrides the root .env for this bundle only.

# NEO4J_URI=neo4j+s://<your-iam-instance>.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# Identity for STDIO clients (Claude Desktop). Set to the current user's identity.
# Must match a principal in the demo dataset, e.g.:
# NEO4J_MCP_PRINCIPAL=joe.hart@bank.com
# Local testing only — lets a tool call pass a `principal` to impersonate.
# NEO4J_MCP_ALLOW_IMPERSONATION=true
