# Optional per-bundle connection override.
# Copy to `.env` (git-ignored) to point this bundle at its own Neo4j instance.
# Anything set here overrides the repo-root .env for this bundle only.

# NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j
